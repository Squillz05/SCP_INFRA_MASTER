entials are set\necho '{\"status\":\"ok\"}'\n"],"query":null,"result":{"status":"ok"},"working_dir":null},"sensitive_attributes":[]}]},{"mode":"data","type":"openstack_networking_network_v2","name":"floating_pool","provider":"provider[\"registry.opentofu.org/terraform-provider-openstack/openstack\"]","instances":[{"schema_version":0,"attributes":{"admin_state_up":"true","all_tags":[],"availability_zone_hints":[],"description":"","dns_domain":"","external":true,"id":"2f96295c-34f6-49a2-b5cf-7f5b407be0c8","matching_subnet_cidr":null,"mtu":1500,"name":"MAIN-NAT","network_id":"2f96295c-34f6-49a2-b5cf-7f5b407be0c8","region":"CyberRange","segments":[],"shared":"true","status":null,"subnets":["fbf166e0-4b80-420b-b346-521e5a06ad0e"],"tags":null,"tenant_id":"488a9396dd1346418c077d5e8b299ca7","transparent_vlan":false},"sensitive_attributes":[]}]},{"mode":"managed","type":"openstack_compute_instance_v2","name":"red_kali","provider":"provider[\"registry.opentofu.org/terraform-provider-openstack/openstack\"].red","instances":[{"index_key":"01","schema_version":0,"attributes":{"access_ip_v4":"10.10.10.166","access_ip_v6":"","admin_pass":null,"all_metadata":{"os":"kali","role":"workstation","team":"red"},"all_tags":[],"availability_zone":"nova","availability_zone_hints":null,"block_device":[],"config_drive":true,"created":"2026-04-08 18:56:26 +0000 UTC","flavor_id":"99e6ce94-23fd-49aa-9d39-b87562583fcd","flavor_name":"large","force_delete":false,"hypervisor_hostname":"","id":"b1945d9f-3dcc-4220-b078-72137a25cf9a","image_id":"56900eb1-e0b2-46fc-ac61-4839f231eb4d","image_name":"Kali2025","key_pair":"","metadata":{"os":"kali","role":"workstation","team":"red"},"name":"RED-KALI-01","network":[{"access_network":false,"fixed_ip_v4":"10.10.10.166","fixed_ip_v6":"","mac":"fa:16:3e:6f:1b:ed","name":"SCPmainnet","port":"","uuid":"ec2ac4a5-e5af-464c-bb0c-f65bad9e2f43"}],"network_mode":null,"personality":[],"power_state":"active","region":"CyberRange","scheduler_hints":[],"security_groups":["