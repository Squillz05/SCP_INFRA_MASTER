# ============================================================
# SCP Foundation Scoring Engine - Environment Configuration
# Generated by Ansible — do not edit manually
# Site Golisano | Echo Team (Grey)
# ============================================================

# ── Database ──────────────────────────────────────────────────
SCORING_DB={{ scoring_db_path }}

# ── Check interval (seconds) ──────────────────────────────────
CHECK_INTERVAL={{ check_interval }}

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_HOST={{ dashboard_host }}
DASHBOARD_PORT={{ dashboard_port }}
HISTORY_HOURS={{ history_hours }}

# ══════════════════════════════════════════════════════════════
# SERVICE HOSTS
# ══════════════════════════════════════════════════════════════

# ── Active Directory (Windows Server) ─────────────────────────
AD_HOST={{ ad_host }}

# ── Apache HTTP (Linux) ───────────────────────────────────────
APACHE_HOST={{ apache_host }}
APACHE_KEYWORD={{ apache_keyword }}

# ── SMTP (Windows Server) ─────────────────────────────────────
SMTP_HOST={{ smtp_host }}
SMTP_EHLO_DOMAIN={{ smtp_ehlo_domain }}

# ── MySQL (Linux) ─────────────────────────────────────────────
MYSQL_HOST={{ mysql_host }}
MYSQL_USER={{ mysql_user }}
MYSQL_PASS={{ mysql_pass }}
MYSQL_DB={{ mysql_db }}

# ── SMB File Share (Windows Server) ───────────────────────────
SMB_HOST={{ smb_host }}
SMB_SHARE={{ smb_share }}
SMB_USER={{ smb_user }}
SMB_PASS={{ smb_pass }}

# ── SSH Server (Ubuntu) ───────────────────────────────────────
SSH_HOST={{ ssh_host }}
{% for user in ssh_users %}
SSH_USER_{{ loop.index }}={{ user.username }}
SSH_PASS_{{ loop.index }}={{ user.password }}
{% endfor %}

# ── OpenVPN (Ubuntu) ──────────────────────────────────────────
OPENVPN_HOST={{ openvpn_host }}
OPENVPN_PORT={{ openvpn_port }}
OPENVPN_PROTO={{ openvpn_proto }}
OPENVPN_MGMT_PORT={{ openvpn_mgmt_port }}
OPENVPN_SSH_USER={{ openvpn_ssh_user }}
OPENVPN_SSH_PASS={{ openvpn_ssh_pass }}
OPENVPN_SSH_KEY={{ openvpn_ssh_key }}
