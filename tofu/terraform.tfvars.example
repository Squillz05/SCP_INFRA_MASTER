# Copy to terraform.tfvars (do not commit secrets / real IDs if the repo is public).

main_project_id = "e5c8122da40747928b67b707f5f00961"
blue_project_id = "REPLACE_WITH_BLUE_PROJECT_UUID"
red_project_id  = "REPLACE_WITH_RED_PROJECT_UUID"

# SCPmainnet (main project). Default in variables.tf matches this; omit or override if the UUID ever changes.
# main_network_id = "ec2ac4a5-e5af-464c-bb0c-f65bad9e2f43"

# Horizon: Compute → Images (override if Glance name differs from variables.tf defaults).
# windows_image_name = "Windows11"
ubuntu_image_name = "Ubuntu 22.04"
kali_image_name    = "Kali Linux 2025"

# Optional: defaults to m1.large in variables.tf if omitted.
# flavor_name = "m1.large"

# Optional: key pair registered in each project for Linux SSH.
linux_key_pair = ""

security_group_names = ["default"]

workstation_enabled = true

# MAIN-NAT (2f96295c-…): use ONE of the patterns below unless you intend both.
#
# A) Floating IP on existing SCPmainnet port (standard pool allocate + associate).
# workstation_floating_ips_enabled = true
#
# B) Second vNIC: Nova attach to MAIN-NAT network_id (avoids direct Neutron port create if policy blocks it).
# workstation_main_nat_interfaces_enabled = true
#
# floating_ip_network_id = "2f96295c-34f6-49a2-b5cf-7f5b407be0c8"
