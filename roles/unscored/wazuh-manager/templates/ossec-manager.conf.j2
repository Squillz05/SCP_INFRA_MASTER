<!--
    Wazuh Manager Configuration
    Managed by Ansible — do not edit manually.
    Role: wazuh-manager
-->
<ossec_config>

  <!-- ====================================================
       Global settings
  ===================================================== -->
  <global>
    <jsonout_output>yes</jsonout_output>
    <alerts_log>yes</alerts_log>
    <logall>yes</logall>
    <logall_json>yes</logall_json>
    <email_notification>{{ unscored_wazuh_email_notification }}</email_notification>
    <smtp_server>localhost</smtp_server>
    <email_from>wazuh@scp.local</email_from>
    <email_to>grey@scp.local</email_to>
    <email_maxperhour>12</email_maxperhour>
    <email_log_source>alerts.log</email_log_source>
    <agents_disconnection_time>2m</agents_disconnection_time>
    <agents_disconnection_alert_time>0</agents_disconnection_alert_time>
  </global>

  <!-- ====================================================
       Alerts
  ===================================================== -->
  <alerts>
    <log_alert_level>{{ unscored_wazuh_alert_log_level }}</log_alert_level>
    <email_alert_level>12</email_alert_level>
  </alerts>

  <!-- ====================================================
       Agent enrollment (authd)
       Agents self-register on port {{ unscored_wazuh_enrollment_port }}
  ===================================================== -->
  <auth>
    <disabled>no</disabled>
    <port>{{ unscored_wazuh_enrollment_port }}</port>
    <use_source_ip>no</use_source_ip>
    <purge>yes</purge>
    <use_password>{{ unscored_wazuh_enrollment_use_password }}</use_password>
    <ciphers>HIGH:!ADH:!EXP:!MD5:!RC4:!3DES:!CAMELLIA:@STRENGTH</ciphers>
    <ssl_verify_host>no</ssl_verify_host>
    <ssl_manager_cert>/var/ossec/etc/sslmanager.cert</ssl_manager_cert>
    <ssl_manager_key>/var/ossec/etc/sslmanager.key</ssl_manager_key>
    <ssl_auto_negotiate>no</ssl_auto_negotiate>
    <force>
      <enabled>yes</enabled>
      <key_mismatch>yes</key_mismatch>
      <disconnected_time enabled="yes">1h</disconnected_time>
      <after_registration_time>1h</after_registration_time>
    </force>
  </auth>

  <!-- ====================================================
       Remote (agent communication)
  ===================================================== -->
  <remote>
    <connection>secure</connection>
    <port>{{ unscored_wazuh_manager_port }}</port>
    <protocol>{{ unscored_wazuh_manager_protocol }}</protocol>
    <queue_size>131072</queue_size>
  </remote>

  <!-- ====================================================
       Logging
  ===================================================== -->
  <logging>
    <log_format>plain</log_format>
  </logging>

  <!-- ====================================================
       File Integrity Monitoring (manager-side)
  ===================================================== -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>{{ unscored_wazuh_fim_frequency }}</frequency>
    <scan_on_start>yes</scan_on_start>
    <alert_new_files>yes</alert_new_files>

{% for dir in unscored_wazuh_fim_dirs %}
    <directories check_all="yes" report_changes="yes" realtime="yes">{{ dir }}</directories>
{% endfor %}

    <!-- Ignore noisy paths -->
    <ignore>/etc/mtab</ignore>
    <ignore>/etc/hosts.deny</ignore>
    <ignore>/etc/mail/statistics</ignore>
    <ignore>/etc/random-seed</ignore>
    <ignore>/etc/adjtime</ignore>
    <ignore>/etc/resolv.conf</ignore>

    <nodiff>/etc/ssl/private.key</nodiff>
    <skip_nfs>yes</skip_nfs>
    <skip_dev>yes</skip_dev>
    <skip_proc>yes</skip_proc>
    <skip_sys>yes</skip_sys>
  </syscheck>

  <!-- ====================================================
       Rootkit detection
  ===================================================== -->
  <rootcheck>
    <disabled>no</disabled>
    <check_files>yes</check_files>
    <check_trojans>yes</check_trojans>
    <check_dev>yes</check_dev>
    <check_sys>yes</check_sys>
    <check_pids>yes</check_pids>
    <check_ports>yes</check_ports>
    <check_if>yes</check_if>
    <frequency>43200</frequency>
    <rootkit_files>etc/shared/rootkit_files.txt</rootkit_files>
    <rootkit_trojans>etc/shared/rootkit_trojans.txt</rootkit_trojans>
    <system_audit>etc/shared/system_audit_rcl.txt</system_audit>
    <system_audit>etc/shared/system_audit_ssh.txt</system_audit>
    <skip_nfs>yes</skip_nfs>
  </rootcheck>

  <!-- ====================================================
       Log analysis — local manager logs
  ===================================================== -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/ossec/logs/active-responses.log</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>

  <!-- ====================================================
       Vulnerability detection
  ===================================================== -->
  <vulnerability-detection>
    <enabled>yes</enabled>
    <index-status>yes</index-status>
    <feed-update-interval>60m</feed-update-interval>
  </vulnerability-detection>

  <!-- ====================================================
       Cluster (single-node, disabled)
  ===================================================== -->
  <cluster>
    <name>wazuh</name>
    <node_name>master-node</node_name>
    <node_type>master</node_type>
    <key>c98b62a9b6169ac5f67dae55ae4a9088</key>
    <port>1516</port>
    <bind_addr>0.0.0.0</bind_addr>
    <nodes>
      <node>{{ unscored_wazuh_manager_ip }}</node>
    </nodes>
    <hidden>no</hidden>
    <disabled>yes</disabled>
  </cluster>

</ossec_config>
