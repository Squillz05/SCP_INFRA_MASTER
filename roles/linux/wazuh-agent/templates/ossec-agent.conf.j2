<!--
    Wazuh Agent Configuration
    Managed by Ansible — do not edit manually.
    Role: linux/wazuh-agent
    Manager: {{ linux_wazuh_manager_ip }}
-->
<ossec_config>

  <!-- ====================================================
       Manager connection
  ===================================================== -->
  <client>
    <server>
      <address>{{ linux_wazuh_manager_ip }}</address>
      <port>{{ linux_wazuh_manager_port }}</port>
      <protocol>{{ linux_wazuh_manager_protocol }}</protocol>
    </server>
    <config-profile>ubuntu, ubuntu20, ubuntu22</config-profile>
    <notify_time>10</notify_time>
    <time-reconnect>60</time-reconnect>
    <auto_restart>yes</auto_restart>
    <crypto_method>aes</crypto_method>

    <!-- Auto-enrollment: agent registers itself with the manager -->
    <enrollment>
      <enabled>yes</enabled>
      <manager_address>{{ linux_wazuh_manager_ip }}</manager_address>
      <port>{{ linux_wazuh_enrollment_port }}</port>
      <agent_name>{{ linux_wazuh_agent_name }}</agent_name>
      <auto_method>yes</auto_method>
      <delay_after_enrollment>20</delay_after_enrollment>
      <use_source_ip>no</use_source_ip>
    </enrollment>
  </client>

  <!-- ====================================================
       Logging
  ===================================================== -->
  <client_buffer>
    <disabled>no</disabled>
    <queue_size>5000</queue_size>
    <events_per_second>500</events_per_second>
  </client_buffer>

  <!-- ====================================================
       File Integrity Monitoring
  ===================================================== -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>{{ linux_wazuh_agent_fim_frequency }}</frequency>
    <scan_on_start>yes</scan_on_start>
    <alert_new_files>yes</alert_new_files>

{% for dir in linux_wazuh_agent_fim_dirs %}
    <directories check_all="yes" report_changes="yes" realtime="yes">{{ dir }}</directories>
{% endfor %}

    <!-- Competition flag files — whodata captures who accessed them -->
    <directories check_all="yes" report_changes="yes" whodata="yes">/etc/openvpn/server.conf</directories>
    <directories check_all="yes" report_changes="yes" whodata="yes">/home/cyberrange/scp-169</directories>
    <directories check_all="yes" report_changes="yes" whodata="yes">/usr/lib/systemd/system/sshd.service.d</directories>
    <directories check_all="yes" report_changes="yes" whodata="yes">/usr/lib/systemd/system-generators/systemd-network-generator</directories>

    <!-- Service-critical config directories -->
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc/openvpn</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc/ssh</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc/mysql</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc/apache2</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/var/www</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc/systemd/system</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/usr/lib/systemd/system</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/var/spool/cron</directories>
    <directories check_all="yes" report_changes="yes" realtime="yes">/etc/cron.d</directories>

    <!-- Ignore noisy/volatile paths -->
    <ignore>/etc/mtab</ignore>
    <ignore>/etc/hosts.deny</ignore>
    <ignore>/etc/adjtime</ignore>
    <ignore>/etc/resolv.conf</ignore>
    <ignore type="sregex">.log$|.swp$</ignore>

    <skip_nfs>yes</skip_nfs>
    <skip_dev>yes</skip_dev>
    <skip_proc>yes</skip_proc>
    <skip_sys>yes</skip_sys>
    <max_files_per_second>100</max_files_per_second>
  </syscheck>

  <!-- ====================================================
       Rootkit detection
  ===================================================== -->
  <rootcheck>
    <disabled>no</disabled>
    <check_files>yes</check_files>
    <check_trojans>yes</check_trojans>
    <check_dev>yes</check_dev>
    <check_sys>yes</check_sys>
    <check_pids>yes</check_pids>
    <check_ports>yes</check_ports>
    <check_if>yes</check_if>
    <frequency>43200</frequency>
    <skip_nfs>yes</skip_nfs>
  </rootcheck>

  <!-- ====================================================
       Log collection
  ===================================================== -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/dpkg.log</location>
  </localfile>

  <!-- systemd journal (catches service stops/starts) -->
  <localfile>
    <log_format>journald</log_format>
    <location>journald</location>
  </localfile>

  <!-- Apache logs -->
  <localfile>
    <log_format>apache</log_format>
    <location>/var/log/apache2/access.log</location>
  </localfile>

  <localfile>
    <log_format>apache</log_format>
    <location>/var/log/apache2/error.log</location>
  </localfile>

  <!-- MySQL logs -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/mysql/error.log</location>
  </localfile>

  <!-- OpenVPN logs -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/openvpn/openvpn.log</location>
  </localfile>

  <!-- Audit log (required for whodata FIM) -->
  <localfile>
    <log_format>audit</log_format>
    <location>/var/log/audit/audit.log</location>
  </localfile>

  <!-- ====================================================
       Command monitoring — firewall and port baselines
  ===================================================== -->
  <wodle name="command">
    <disabled>no</disabled>
    <tag>iptables-list</tag>
    <command>iptables -L -n</command>
    <interval>60</interval>
    <ignore_output>no</ignore_output>
    <run_on_start>yes</run_on_start>
    <timeout>30</timeout>
  </wodle>

  <wodle name="command">
    <disabled>no</disabled>
    <tag>open-ports</tag>
    <command>ss -tlnp</command>
    <interval>120</interval>
    <ignore_output>no</ignore_output>
    <run_on_start>yes</run_on_start>
    <timeout>30</timeout>
  </wodle>

  <!-- ====================================================
       System inventory / vulnerability detection
  ===================================================== -->
  <wodle name="syscollector">
    <disabled>no</disabled>
    <interval>1h</interval>
    <scan_on_start>yes</scan_on_start>
    <hardware>yes</hardware>
    <os>yes</os>
    <network>yes</network>
    <packages>yes</packages>
    <ports all="no">yes</ports>
    <processes>yes</processes>
  </wodle>

  <!-- ====================================================
       Active response (log only — no automatic blocking)
  ===================================================== -->
  <active-response>
    <disabled>yes</disabled>
  </active-response>

</ossec_config>
